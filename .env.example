# PostgreSQL
POSTGRES_DB=devportfolio
POSTGRES_USER=devportfolio
POSTGRES_PASSWORD=change-me

# Backend
# Origem permitida pelo CORS (URL onde o frontend roda)
APP_CORS_ORIGIN=http://localhost:4200
# URL pública usada em tags de SEO/Open Graph (canonical, og:url) — ver ADR-007
APP_PUBLIC_BASE_URL=http://localhost:4200

# Integração com GitHub (Fase 8, opcional — ver ADR-008)
# 1. Crie um OAuth App em https://github.com/settings/developers
# 2. "Authorization callback URL" deve ser exatamente: {APP_PUBLIC_BASE_URL}/api/v1/github/callback
# 3. Cole o Client ID e gere um Client Secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Chave AES-256 em base64 (ex.: `openssl rand -base64 32`) usada para cifrar o
# access token do GitHub em repouso. Gere uma chave própria — nunca reaproveite
# o exemplo abaixo em produção.
APP_TOKEN_ENCRYPTION_KEY=
